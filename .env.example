# ============================================================
# .env.example — Copy thành .env và điền giá trị thực
# KHÔNG commit file .env vào git
# ============================================================

# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-this
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SMTP notifications (leave EMAIL_HOST empty to print emails to the local console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=

# Redis dùng chung khi chạy nhiều web process / WebSocket trong giải thật.
# Để trống khi chạy local một process.
REDIS_URL=

# Judge0 API
# Sử dụng instance công khai: https://ce.judge0.com
# Hoặc tự deploy: https://judge0.com
JUDGE0_BASE_URL=https://ce.judge0.com

# API key cho Judge0 (nếu instance yêu cầu xác thực, để trống nếu không có)
JUDGE0_API_KEY=

# Giới hạn thực thi (giây)
JUDGE0_CPU_TIME_LIMIT=2
JUDGE0_WALL_TIME_LIMIT=5

# Giới hạn bộ nhớ (kilobytes)
JUDGE0_MEMORY_LIMIT=131072

# Kích thước mã nguồn tối đa (bytes), mặc định 65536 = 64KB
SUBMISSION_MAX_CODE_SIZE=65536

# Số lần nộp tối đa mỗi user mỗi ngày
SUBMISSION_RATE_LIMIT_PER_DAY=50

# Thời gian timeout khi gọi Judge0 API (giây)
JUDGE0_REQUEST_TIMEOUT=30

# Số lần thử lại khi poll kết quả từ Judge0
JUDGE0_POLL_MAX_RETRIES=15

# Sandbox backend: 'isolate' (mặc định nếu có Isolate, siêu nhanh, không cần sudo) hoặc 'docker'
SANDBOX_BACKEND=isolate

